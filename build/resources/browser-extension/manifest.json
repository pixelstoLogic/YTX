{
  "manifest_version": 3,
  "name": "YTX YouTube Trim Handoff",
  "version": "1.1.5",
  "description": "Open a YouTube video preview in YTX Studio to trim and export.",
  "permissions": [],
  "host_permissions": ["https://www.youtube.com/*", "https://youtu.be/*"],
  "content_scripts": [{
    "matches": ["https://www.youtube.com/*", "https://youtu.be/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}

